<?xml version="1.0" encoding="utf-8"?>
<!-- Biến thể dark mode: tránh splash/window nền trắng chói khi hệ điều hành đang dark -->
<resources>

    <style name="Theme.MuslimVN" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_background_night</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background_night</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MuslimVN</item>
    </style>
</resources>
